{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "problem_tracker.csv row",
  "description": "One row per problem in tracking/problem_tracker.csv.",
  "type": "object",
  "required": [
    "problem_id",
    "problem_name",
    "source",
    "topic",
    "difficulty",
    "language",
    "status",
    "mastery_level"
  ],
  "properties": {
    "problem_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Slug, unique across the tracker."
    },
    "problem_name": { "type": "string", "minLength": 1 },
    "source": {
      "type": "string",
      "enum": ["neetcode", "leetcode", "course", "book", "other"]
    },
    "problem_url": { "type": "string" },
    "topic": { "type": "string", "minLength": 1 },
    "subtopic": { "type": "string" },
    "difficulty": {
      "type": "string",
      "enum": ["easy", "medium", "hard", "n/a"]
    },
    "language": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["unsolved", "in-progress", "solved", "retired"]
    },
    "mastery_level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "first_attempt_date": {
      "type": "string",
      "pattern": "^(|\\d{4}-\\d{2}-\\d{2})$"
    },
    "solved_date": {
      "type": "string",
      "pattern": "^(|\\d{4}-\\d{2}-\\d{2})$"
    },
    "last_review_date": {
      "type": "string",
      "pattern": "^(|\\d{4}-\\d{2}-\\d{2})$"
    },
    "next_review_date": {
      "type": "string",
      "pattern": "^(|\\d{4}-\\d{2}-\\d{2})$"
    },
    "attempt_count": {
      "type": "integer",
      "minimum": 0
    },
    "time_complexity": { "type": "string" },
    "space_complexity": { "type": "string" },
    "solution_path": { "type": "string" },
    "notebook_path": { "type": "string" },
    "notes": { "type": "string" }
  }
}
